    },
    {
      "@id": "item_20",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Aging Civic Leadership",
      "description": "Local civic organizations are heavily reliant on aging populations for leadership and membership, struggling to recruit younger generations who face competing career and family priorities.",
      "x": 296,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-20",
      "children": []
    },
    {
      "@id": "item_21",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Uncontested Local Candidate Transparency",
      "description": "It is incredibly difficult to research the records of local election candidates, especially those running uncontested or without a communications budget, leaving voters feeling uninformed.",
      "x": 592,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-21",
      "children": []
    },
    {
      "@id": "item_22",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Unexplained Ballot Roles",
      "description": "Even where ranked-choice mechanics were well taught, voters lack a plain-language breakdown of what each office on the ballot actually does, leaving first-time voters guessing at the roles they're electing.",
      "x": 888,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-22",
      "children": []
    },
    {
      "@id": "item_23",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Performative Bipartisanship",
      "description": "Statements, town halls, and pledges perform collaboration without doing it; missing is a structured, sprint-like way for people who are supposed to disagree to define a shared problem and build something together.",
      "x": 1184,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-23",
      "children": []
    },
    {
      "@id": "item_24",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Loneliness as a Civic Problem",
      "description": "The social scaffolding that once created accountability in how people form relationships has dissolved with nothing replacing it — an isolation epidemic treated as a private matter rather than missing civic infrastructure.",
      "x": 1480,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-24",
      "children": []
    },
    {
      "@id": "item_25",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Outdated Small-Organization Elections",
      "description": "Unions, HOAs, and nonprofit boards run consequential elections on paper ballots and opaque spreadsheets; available tools serve incumbent leadership rather than transparent, verifiable results for members.",
      "x": 1776,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-25",
      "children": []
    },
    {
      "@id": "item_26",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Eroded Respect for Disagreement",
      "description": "People can no longer agree to disagree — basic respect for others and their opinions is missing from civic life, and active listening is rare.",
      "x": 2072,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-26",
      "children": []
    },
    {
      "@id": "item_27",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Misunderstood Pace of Government",
      "description": "Constituents misjudge who holds which powers and how fast government was designed to move, so legitimate slowness reads as failure — and stretched congressional staff can't give every issue the weight visitors expect.",
      "x": 2368,
      "y": 650,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-27",
      "children": []
    },
    {
      "@id": "item_28",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Cross-Jurisdiction Election Distrust",
      "description": "Election officials struggle to cut through fragmented information channels, and even people who trust their own town's elections increasingly distrust elections run by other cities and states.",
      "x": 0,
      "y": 825,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-28",
      "children": []
    },
    {
      "@id": "item_29",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "No Playbook for Good Citizenship",
      "description": "There is no clear guide to the daily, weekly, and monthly steps of being an informed, participating citizen — the information is scattered everywhere, and the whole project feels overwhelming.",
      "x": 296,
      "y": 825,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-29",
