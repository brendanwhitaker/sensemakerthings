      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Low-Information Voting & Gerrymandering",
      "description": "Many voters don't research candidates before an election, while nationwide gerrymandering and proposed federal voting restrictions make the underlying playing field less fair.",
      "x": 1184,
      "y": 825,
      "w": 240,
      "h": 110,
