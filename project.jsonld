    {
      "@id": "item_42",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Mid-Decade Redistricting Shifts",
      "description": "California, Missouri, North Carolina, and Texas will use different congressional maps in 2026 than in 2024 due to voluntary mid-decade redistricting — unusual, and worth watching for how it shifts competitive-district counts.",
      "x": 592,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-42",
      "children": []
    },
    {
      "@id": "item_43",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Accountability for Public Lies",
      "description": "Telling the truth — and holding liars accountable and responsible — is named as the missing piece of civic life.",
      "x": 888,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-43",
      "children": []
    },
    {
      "@id": "item_44",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Cross-Agency Coordination Failure",
      "description": "Constituent problems take years to solve because coordinating local, federal, and neighboring-state agencies, private entities, and residents is nearly impossible — stakeholders claim jurisdiction for credit and duck it for problem-solving, at great cost to unpaid commissioners.",
      "x": 296,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-44",
      "children": []
    },
    {
      "@id": "item_45",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Sidewalks vs. Micromobility",
      "description": "DC sidewalks are increasingly dangerous for elderly, young, and disabled pedestrians as motorized bikes and scooters — often ridden illegally — collide with the city's walkability promise; other cities' regulations may hold lessons.",
      "x": 1184,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-45",
      "children": []
    },
    {
      "@id": "item_46",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Representatives Without Accountability",
      "description": "Representatives don't seem to answer to the people, and replacing them changes little — new reps inherit the same voting patterns, with the two-party system and polarization at the crux.",
      "x": 1480,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-46",
      "children": []
    },
    {
      "@id": "item_47",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Last-Mile Resource Disconnect",
      "description": "Programs, grants, and services exist on paper, but communities often don't know about them or can't navigate them — the gap is grassroots outreach, trusted local partners, and hands-on navigation support, not new programs.",
      "x": 1776,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-47",
      "children": []
    },
    {
      "@id": "item_48",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Campus–Neighborhood Disconnection",
      "description": "There is no single, easy channel for a university community and its neighbors to trade information and opportunities — student jobs, local events, programs, and campus resources live in scattered slices.",
      "x": 2072,
      "y": 1000,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-48",
      "children": []
    },
