      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Hopelessness & Lack of Election Information",
      "description": "Voters feel hopeless and lack basic awareness of when local elections occur, relying on passive information like mailers or word of mouth.",
