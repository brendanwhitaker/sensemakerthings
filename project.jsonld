      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "The Death of Political Compromise",
      "description": "The electorate and activists are failing to recognize that compromise is a fundamental component of democracy, negatively impacting civic engagement.",
