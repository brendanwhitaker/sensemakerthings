      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "AI Bot Interference in Constituent Engagement",
      "description": "Artificial intelligence is being used to flood communication channels, rendering actual, organic constituent engagement ineffective.",
